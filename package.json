{
  "name": "agenthands",
  "version": "0.6.0",
  "type": "module",
  "description": "Agent Hands — local server for tools, MCP, KV and datatables that Claude Code / Codex connect to.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "src/server",
    "src/web",
    "src/cli"
  ],
  "scripts": {
    "dev:server": "bun --watch src/server/src/index.ts --port 18429 --data-dir $HOME/.open-agent-hands-dev",
    "dev:web": "cd src/web && API_PORT=18429 bun run dev",
    "dev": "concurrently --names \"server,web\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"bun run dev:server\" \"bun run dev:web\"",
    "start": "bun src/server/src/index.ts",
    "build:web": "cd src/web && bun run build",
    "build": "bun run build:web && bun run build:binary",
    "lint": "bunx biome lint ./src/web",
    "lint:fix": "bunx biome lint ./src/web --write",
    "format": "bunx biome format ./src/web --write",
    "biome:check": "bunx biome check --write ./src/web",
    "typecheck": "cd src/web && bun check",
    "typecheck:server": "cd src/server && bun check",
    "typecheck:web": "cd src/web && bun check",
    "typecheck:cli": "cd src/cli && bun check",
    "test": "bun test src/server/src/__tests__/ src/cli/test/",
    "test:watch": "bun test --watch src/server/src/__tests__/ src/cli/test/",
    "build:binary": "bun scripts/build-binary.ts --skip-web",
    "build:cli": "bun scripts/build-cli.ts",
    "build:binary:all": "bun run build:web && bun scripts/build-binary.ts --skip-web --all",
    "build:desktop": "bun scripts/build-desktop.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "concurrently": "^9.2.1",
    "typescript": "~5.8.3"
  }
}
